{
  "name": "magpie-cache-guard",
  "version": "0.8.0",
  "description": "magpie plugin: prompt-cache dashboard (1h / today / 7d / 30d) with per-agent-model hit rates and low-hit alerts",
  "type": "module",
  "main": "./index.mjs",
  "files": ["index.mjs", "README.md", "LICENSE", "scripts", "page/index.html", "page/app.js", "page/style.css", "page/icon.svg", "page/icons"],
  "repository": { "type": "git", "url": "https://github.com/x-mug/magpie-plugins.git", "directory": "plugins/magpie-cache-guard" },
  "homepage": "https://github.com/x-mug/magpie-plugins/tree/main/plugins/magpie-cache-guard",
  "bugs": { "url": "https://github.com/x-mug/magpie-plugins/issues" },
  "keywords": ["magpie", "magpie-plugin", "cache", "monitor"],
  "license": "MIT",
  "magpie": {
    "maxConcurrency": 4,
    "page": {
      "title": "Cache guard",
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "titles": { "zh": "缓存看守" }
    },
    "options": {
      "threshold": 0.8,
      "consecutive": 5,
      "minPrompt": 15000,
      "minRequests": 10,
      "pollSec": 10,
      "cooldownSec": 1800,
      "maxAlertsPerHour": 6,
      "notify": "toast",
      "ignore": []
    }
  }
}